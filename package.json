{
  "name": "browsemux",
  "version": "0.1.0",
  "description": "A bounded decision bridge between agent harnesses and browser backends.",
  "author": "xenstar",
  "homepage": "https://github.com/xenstar/browsemux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenstar/browsemux.git"
  },
  "bugs": {
    "url": "https://github.com/xenstar/browsemux/issues"
  },
  "type": "module",
  "bin": {
    "browsemux": "bin/browsemux.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./backends": "./src/backends/index.mjs",
    "./decisions": "./src/decisions/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "PRIVACY.md",
    "LICENSE",
    "NOTICE.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "node --check bin/browsemux.mjs && node --check src/cli.mjs",
    "prepublishOnly": "npm test && npm run check"
  },
  "keywords": [
    "browser",
    "agent",
    "automation",
    "jev",
    "typesafe",
    "openrouter",
    "agent-browser",
    "bsk"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
