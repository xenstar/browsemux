{
  "name": "browsemux",
  "version": "0.1.0",
  "description": "A bounded decision bridge between agent harnesses and browser backends.",
  "type": "module",
  "bin": {
    "browsemux": "bin/browsemux.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./backends": "./src/backends/index.mjs",
    "./decisions": "./src/decisions/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "node --check bin/browsemux.mjs && node --check src/cli.mjs"
  },
  "keywords": [
    "browser",
    "agent",
    "automation",
    "jev",
    "typesafe",
    "openrouter",
    "agent-browser",
    "bsk"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
